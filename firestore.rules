rules_version = '2';

// Every signed-in person gets exactly one document at /users/{their own uid}.
// That document holds their whole Meals4Us state (family profile, week plan,
// grocery list, custom recipes, feedback history). Nobody can read or write
// anyone else's document — this is what keeps one family's meal plan private
// from every other family using the app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
